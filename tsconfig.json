{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    "paths": {
      "@offgrid/core/*": ["./src/*"],
      "react-native-fs": ["./src/shims/react-native-fs.ts"],
      "@offgrid/chat": ["./packages/chat/src/index.ts"],
      "@offgrid/models": ["./packages/models/src/index.ts"],
      "@offgrid/rag": ["./packages/rag/src/index.ts"],
      "@offgrid/speech": ["./packages/speech/src/index.ts"],
      "@offgrid/ui": ["./packages/ui/src/index.ts"]
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
